<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.mybatisgx</groupId>
		<artifactId>mybatisgx-spring-boot</artifactId>
		<version>0.4.3-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>mybatisgx-spring-boot3-mp-compat-starter</artifactId>
	<name>mybatisgx-spring-boot3-mp-compat-starter</name>
	<url>http://www.mybatisgx.com</url>

	<description>
		Spring Boot 3 starter for MyBatisGX + MyBatis-Plus coexistence.
		Enables incremental adoption: keep existing MP mappers untouched while adding MyBatisGX DAOs.
	</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<java.version>17</java.version>
		<spring.web.version>6.2.15</spring.web.version>
		<mybatisplus.boot.version>3.5.17</mybatisplus.boot.version>
		<mybatisplus.version>3.5.17</mybatisplus.version>
		<jackson.version>2.19.0</jackson.version>
		<slf4j.api.version>2.0.17</slf4j.api.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<version>${spring.web.version}</version>
		</dependency>

		<!-- MyBatisGX 核心与 Spring 集成（含 SqlSessionFactoryBeanPostProcessor） -->
		<dependency>
			<groupId>com.mybatisgx</groupId>
			<artifactId>mybatisgx-spring</artifactId>
			<version>${mybatisgx.sb3.version}</version>
		</dependency>
		<!-- MyBatisGX + MyBatis-Plus 共存 Configuration -->
		<dependency>
			<groupId>com.mybatisgx</groupId>
			<artifactId>mybatisgx-mybatis-plus-compat</artifactId>
			<version>${mybatisgx.sb3.version}</version>
		</dependency>

		<!-- MyBatis-Plus Boot3 starter：提供 MP 自动配置与 SqlSessionFactory 创建（含 spring-boot/spring 传递依赖） -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>${mybatisplus.boot.version}</version>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-extension</artifactId>
			<version>${mybatisplus.version}</version>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-jsqlparser</artifactId>
			<version>${mybatisplus.version}</version>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<!-- mybatisgx-core 传递引入 slf4j-api 1.7.x，与 Boot 3 的 logback 1.5.x（需 slf4j 2.x）冲突，显式对齐 slf4j 2.x（main 代码直接使用 org.slf4j，须为 compile scope；示例工程同样显式声明） -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.api.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<version>3.5.9</version>
			<scope>test</scope>
		</dependency>
		<!-- MP 3.5.17 传递引入 spring-boot 3.5.9（logback 1.5.x）；测试依赖必须对齐到同一世代，
		     否则 spring-boot 3.5.9 的 LogbackLoggingSystem 在 logback 1.4.x（boot 3.1.x）上会
		     NoClassDefFoundError: ch/qos/logback/core/util/StatusPrinter2 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
			<version>3.5.9</version>
			<scope>test</scope>
		</dependency>
		<!-- H2：测试环境代替 MySQL，兼容 MySQL 模式 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>2.1.212</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!-- JUnit 5 需要 surefire 3.x -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
			</plugin>
		</plugins>
	</build>
</project>
